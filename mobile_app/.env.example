# Public HTTPS Apper edge-function invoke URL. Never put APPER_API_KEY in this file.
EXPO_PUBLIC_API_BASE=https://YOUR-APPER-EDGE-FUNCTION-URL
# Optional Google Maps SDK key, a public client key with platform/API restrictions.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional override for the nearby-provider search radius (1–50 km; default 15).
EXPO_PUBLIC_DISCOVERY_RADIUS_KM=15
# Optional verified Customer Care number in E.164 format, e.g. +91...
EXPO_PUBLIC_CUSTOMER_CARE_PHONE=
