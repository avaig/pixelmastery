{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE": "https://YOUR-APPER-EDGE-FUNCTION-URL" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE": "https://YOUR-APPER-EDGE-FUNCTION-URL" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_BASE": "https://YOUR-APPER-EDGE-FUNCTION-URL" }
    }
  }
}
